# Deriv API — your registered app's ID from developers.deriv.com (or use 1089 for the shared test app)
DERIV_APP_ID=1089
# Not required anymore for normal use — tokens now come from the OAuth login
# flow at /auth/login, saved automatically to deriv-tokens.json. Only fill
# this in if you want to test with a manually-pasted token instead.
DERIV_API_TOKEN=
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# Which account this process is trading: "demo" or "live"
TRADING_MODE=demo

# Risk settings
LIVE_ACCOUNT_START_BALANCE=10
LIVE_DAILY_LOSS_LIMIT=2
RISK_PER_TRADE_PCT=0.75

# Promotion gate
MIN_TRADES_FOR_EVAL=40
MIN_WIN_RATE_PCT=80
MIN_PROFIT_FACTOR=1.5
MAX_DEMO_DRAWDOWN_PCT=20
TRIAL_EXTENSION_DAYS=3
TRIAL_MAX_DAYS=14

# Kill switch webhook (called by your WhatsApp bot)
KILL_SWITCH_SECRET=choose_a_long_random_string
PORT=3000

# News blackout (economic calendar API — plug in Forex Factory/Finnhub/Trading Economics)
NEWS_API_KEY=
NEWS_BLACKOUT_MINUTES=20

# WhatsApp alerts — reuse the same Meta WhatsApp Cloud API credentials your
# whatsapp-ai-bot already uses (access token + phone number ID), and your own
# number to send alerts to (country code, no +, e.g. 2547XXXXXXXX)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
